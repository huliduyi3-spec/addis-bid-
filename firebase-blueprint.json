{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with wallet balance and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "balance": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "balance", "role", "createdAt"]
    },
    "Auction": {
      "title": "Auction",
      "description": "Live or completed reverse auction lot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "marketValue": { "type": "number" },
        "entryFee": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "ended", "upcoming"] },
        "imageUrl": { "type": "string" },
        "totalBids": { "type": "number" },
        "winnerId": { "type": "string" },
        "winnerPrice": { "type": "number" },
        "winnerName": { "type": "string" },
        "endsAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "marketValue", "entryFee", "status", "imageUrl", "totalBids", "endsAt", "createdAt"]
    },
    "Bid": {
      "title": "Bid",
      "description": "A secret bid placed on an auction by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "auctionId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "placedAt": { "type": "string" }
      },
      "required": ["id", "auctionId", "userId", "userName", "amount", "placedAt"]
    },
    "Deposit": {
      "title": "Deposit",
      "description": "Telebirr or CBE transfer deposit request awaiting admin approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["telebirr", "cbe", "chapa"] },
        "transactionId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "amount", "method", "transactionId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with private balance and role"
    },
    "/auctions/{auctionId}": {
      "schema": "Auction",
      "description": "Public reverse auction lots"
    },
    "/auctions/{auctionId}/bids/{bidId}": {
      "schema": "Bid",
      "description": "Bids placed on a specific auction"
    },
    "/deposits/{depositId}": {
      "schema": "Deposit",
      "description": "Telebirr and bank deposit transactions"
    }
  }
}
